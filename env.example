# NZO Industries — salin ke .env.local dan isi nilai asli
# copy env.example .env.local   (Windows) / cp env.example .env.local   (Unix)
#
# Aturan: hanya variabel NEXT_PUBLIC_* yang boleh sampai ke browser.
# Semua variabel lain SERVER ONLY — dibaca lewat src/lib/env.ts (import "server-only").
# Jangan pernah commit .env.local.

# ============================================================
# APP
# ============================================================
# TODO [P-09]: domain final
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server only. Bearer token untuk /api/cron/* dan cek DB di /api/health.
# Buat dengan: openssl rand -base64 32
CRON_SECRET=generate_with_openssl_rand_base64_32

# ============================================================
# SUPABASE (region Singapore) [P-03]
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server only. Bypass RLS — pakai hanya di server action / route handler.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# CLOUDINARY (foto produk, banner, brand, konten)
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Server only. Upload selalu signed dari /api/cloudinary/sign.
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# ============================================================
# RESEND (email transaksional + SMTP Supabase Auth) [P-09]
# ============================================================
# Server only.
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=NZO Industries
RESEND_ADMIN_EMAIL=admin@yourdomain.com

# ============================================================
# MAYAR (Headless API V2) [P-02]
# ============================================================
# Server only. Sandbox: web.mayar.club/api-keys | Production: web.mayar.id/api-keys
MAYAR_API_KEY=xxxx
# Server only. Callback token dashboard Mayar (header x-callback-token).
MAYAR_WEBHOOK_TOKEN=xxxx
# false = sandbox (api.mayar.club), true = production (api.mayar.id)
MAYAR_IS_PRODUCTION=false
# Webhook URL di dashboard Mayar: ${NEXT_PUBLIC_APP_URL}/api/webhooks/mayar

# ============================================================
# BITESHIP (ongkir & resi) [P-11] [P-12]
# ============================================================
# Server only.
BITESHIP_API_KEY=biteship_test.xxxx
BITESHIP_IS_PRODUCTION=false
# Asal pengiriman = gudang (P-11). Area ID lebih akurat dari kode pos.
BITESHIP_ORIGIN_POSTAL_CODE=10110
BITESHIP_ORIGIN_AREA_ID=
# Kode kurir dipisah koma (P-12).
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
# Berat per item bila data berat produk kosong (gram).
DEFAULT_ITEM_WEIGHT_GRAMS=1000
# true = tarif uji saat BITESHIP_API_KEY kosong (dev/staging saja, D-30).
SHIPPING_TEST_RATES=false

# ============================================================
# JUBELIO (import katalog awal) [P-04]
# ============================================================
# Server only. Akun integrasi khusus dari klien — jangan pakai akun pribadi.
JUBELIO_BASE_URL=https://api2.jubelio.com
JUBELIO_EMAIL=integration@example.com
JUBELIO_PASSWORD=xxxx

# ============================================================
# UPSTASH REDIS (rate limit)
# ============================================================
# Server only.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ============================================================
# CLOUDFLARE TURNSTILE (form auth & checkout)
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
# Server only.
TURNSTILE_SECRET_KEY=your_secret_key_here

# ============================================================
# ANALYTICS
# ============================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# ============================================================
# WHATSAPP CS
# ============================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
